# =============================================================================
# CIY (Craft It Yourself) — Environment Configuration Example
# Copy this file to `.env.local` and fill in the values you need.
# Missing optional values degrade gracefully in local development mode.
# =============================================================================

# --- Site URL ---
# Used for absolute URLs in metadata, sitemap, and Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI Provider Keys (server-side only — never expose via NEXT_PUBLIC_*) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Session Token Signing Secret ---
# Used to HMAC-sign client session/credit tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters in production.
CIY_SESSION_SECRET=

# --- Stripe Payments (optional in local dev) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (recurring monthly plans & one-time credit packs)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CRAFTER=
STRIPE_PRICE_MASTER=
STRIPE_PRICE_PASS_NORMAL=
STRIPE_PRICE_PASS_MEDIUM=
STRIPE_PRICE_PASS_ADVANCED=

# --- Supabase Auth & Database (optional in local dev) ---
# Run lib/supabase/schema.sql in the Supabase SQL Editor to initialize tables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstash Redis Rate Limiting (optional in local dev, recommended in prod) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sentry Error Tracking (optional) ---
SENTRY_DSN=
SENTRY_RELEASE=

# --- PostHog Analytics (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Resend Transactional Email (optional) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
